{{!
    @template mod_playercards/board_panel

    Renders the PlayerCards board in one of three states: no match in progress (lobby),
    mulligan decision pending, or the main board (SCOPE.md 16, Fase 3 Etapas 1-2). Every
    boolean/list here is pre-computed client-side by amd/src/board.js from the raw
    start_match/mulligan/get_state/muster_guardian/change_posture/declare_attack Web
    Service response — this template stays logic-less. The contextual action bar
    (posture choice during a muster, attack/change-posture/cancel buttons for a selected
    Guardian) is built entirely in JS into #playercards-actionbar, not templated here.

    Example context (json):
    {
        "showlobby": false,
        "showmulligan": true,
        "showmain": false,
        "difficulties": [
            {"value": "easy", "label": "Easy", "selected": false},
            {"value": "normal", "label": "Normal", "selected": true},
            {"value": "hard", "label": "Hard", "selected": false}
        ],
        "cointossmessage": "You won the coin toss and go first.",
        "turnlabel": "Turn 1",
        "activeplayerlabel": "Your turn",
        "humanlp": 10000,
        "ailp": 10000,
        "aihandcount": 5,
        "humandeckcount": 35,
        "aideckcount": 20,
        "hand": [
            {"uid": "h1", "isguardian": true, "name": "Sentinela Novata", "atk": 400, "def": 0, "level": 1},
            {"uid": "h2", "isguardian": false, "name": "Fragmento de Sabedoria", "subtypelabel": "Info"}
        ],
        "guardianslotlabel": "Empty Guardian slot",
        "loreslotlabel": "Empty Lore slot",
        "fieldslots": [1, 2, 3, 4, 5],
        "aislots": [
            {"index": 0, "occupied": false},
            {
                "index": 1, "occupied": true, "name": "Golem de Aço", "atk": 400, "def": 1200,
                "posturelabel": "Attack posture", "sicklabel": ""
            }
        ],
        "humanslots": [
            {"index": 0, "occupied": false},
            {
                "index": 1, "occupied": true, "name": "Sentinela Novata", "atk": 400, "def": 0,
                "posturelabel": "Defense posture", "sicklabel": "Summoned this turn"
            }
        ]
    }
}}
{{#showlobby}}
    <div class="playercards-lobby">
        <div class="form-group">
            <label for="playercards-difficulty-select">{{#str}} selectdifficulty, mod_playercards {{/str}}</label>
            <select id="playercards-difficulty-select" class="form-select">
                {{#difficulties}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/difficulties}}
            </select>
        </div>
        <button type="button" class="btn btn-primary" id="playercards-startmatch-btn">
            {{#str}} startmatch, mod_playercards {{/str}}
        </button>
    </div>
{{/showlobby}}
{{#showmulligan}}
    <div class="playercards-mulligan">
        <p class="playercards-cointoss">{{cointossmessage}}</p>
        <div class="playercards-hand" role="list" aria-label="{{#str}} yourhand, mod_playercards {{/str}}">
            {{#hand}}
                <div class="playercards-card" role="listitem" data-uid="{{uid}}">
                    <div class="playercards-card-name">{{name}}</div>
                    {{#isguardian}}
                        <div class="playercards-card-stats">ATK {{atk}} / DEF {{def}} (Lv.{{level}})</div>
                    {{/isguardian}}
                    {{^isguardian}}
                        <div class="playercards-card-subtype">{{subtypelabel}}</div>
                    {{/isguardian}}
                </div>
            {{/hand}}
        </div>
        <button type="button" class="btn btn-primary" id="playercards-keephand-btn">
            {{#str}} keephand, mod_playercards {{/str}}
        </button>
        <button type="button" class="btn btn-secondary" id="playercards-redrawhand-btn">
            {{#str}} redrawhand, mod_playercards {{/str}}
        </button>
    </div>
{{/showmulligan}}
{{#showmain}}
    <div class="playercards-board-main">
        <div class="playercards-status-bar">
            <span class="playercards-turnlabel">{{turnlabel}}</span>
            <span class="playercards-activeplayer">{{activeplayerlabel}}</span>
        </div>
        <div class="playercards-lp-row">
            <span class="playercards-lp playercards-lp-ai">{{#str}} lifepoints, mod_playercards {{/str}}: {{ailp}}</span>
            <span class="playercards-lp playercards-lp-human">{{#str}} lifepoints, mod_playercards {{/str}}: {{humanlp}}</span>
        </div>

        <div class="playercards-zone playercards-zone-ai">
            <div class="playercards-zone-label">{{#str}} opponenthand, mod_playercards {{/str}} ({{aihandcount}})</div>
            <div class="playercards-slots" role="list" aria-label="{{#str}} guardianslots, mod_playercards {{/str}}">
                {{#aislots}}
                    <div
                        class="playercards-slot {{#occupied}}playercards-slot-guardian{{/occupied}}{{^occupied}}playercards-slot-empty{{/occupied}}"
                        role="listitem"
                        data-zone="ai"
                        data-slot="{{index}}"
                        aria-label="{{#occupied}}{{name}}{{/occupied}}{{^occupied}}{{../guardianslotlabel}}{{/occupied}}"
                    >
                        {{#occupied}}
                            <div class="playercards-card-name">{{name}}</div>
                            <div class="playercards-card-stats">ATK {{atk}} / DEF {{def}}</div>
                            <div class="playercards-card-posture">{{posturelabel}}</div>
                            {{#sicklabel}}<div class="playercards-card-sick">{{sicklabel}}</div>{{/sicklabel}}
                        {{/occupied}}
                    </div>
                {{/aislots}}
            </div>
            <div class="playercards-slots" role="list" aria-label="{{#str}} loreslots, mod_playercards {{/str}}">
                {{#fieldslots}}
                    <div class="playercards-slot playercards-slot-empty" role="listitem" aria-label="{{loreslotlabel}}"></div>
                {{/fieldslots}}
            </div>
            <div class="playercards-deckcount">{{aideckcount}}</div>
        </div>

        <div id="playercards-actionbar" class="playercards-actionbar"></div>

        <div class="playercards-zone playercards-zone-human">
            <div class="playercards-slots" role="list" aria-label="{{#str}} loreslots, mod_playercards {{/str}}">
                {{#fieldslots}}
                    <div class="playercards-slot playercards-slot-empty" role="listitem" aria-label="{{loreslotlabel}}"></div>
                {{/fieldslots}}
            </div>
            <div class="playercards-slots" role="list" aria-label="{{#str}} guardianslots, mod_playercards {{/str}}">
                {{#humanslots}}
                    <div
                        class="playercards-slot {{#occupied}}playercards-slot-guardian{{/occupied}}{{^occupied}}playercards-slot-empty{{/occupied}}"
                        role="listitem"
                        data-zone="human"
                        data-slot="{{index}}"
                        aria-label="{{#occupied}}{{name}}{{/occupied}}{{^occupied}}{{../guardianslotlabel}}{{/occupied}}"
                    >
                        {{#occupied}}
                            <div class="playercards-card-name">{{name}}</div>
                            <div class="playercards-card-stats">ATK {{atk}} / DEF {{def}}</div>
                            <div class="playercards-card-posture">{{posturelabel}}</div>
                            {{#sicklabel}}<div class="playercards-card-sick">{{sicklabel}}</div>{{/sicklabel}}
                        {{/occupied}}
                    </div>
                {{/humanslots}}
            </div>
            <div class="playercards-deckcount">{{humandeckcount}}</div>
            <div class="playercards-zone-label">{{#str}} yourhand, mod_playercards {{/str}}</div>
            <div class="playercards-hand" role="list" aria-label="{{#str}} yourhand, mod_playercards {{/str}}">
                {{#hand}}
                    <div class="playercards-card" role="listitem" data-uid="{{uid}}">
                        <div class="playercards-card-name">{{name}}</div>
                        {{#isguardian}}
                            <div class="playercards-card-stats">ATK {{atk}} / DEF {{def}} (Lv.{{level}})</div>
                        {{/isguardian}}
                        {{^isguardian}}
                            <div class="playercards-card-subtype">{{subtypelabel}}</div>
                        {{/isguardian}}
                    </div>
                {{/hand}}
            </div>
        </div>
    </div>
{{/showmain}}
