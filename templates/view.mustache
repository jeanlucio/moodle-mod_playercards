{{!
    @template mod_playercards/view

    PlayerCards main activity page (Fase 2 placeholder — the interactive board arrives in
    Fase 3, SCOPE.md 16).

    Example context (json):
    {
        "intro": "<p>Duel an AI opponent to review course content.</p>",
        "hasintro": true
    }
}}
<div class="path-mod-playercards">
    {{#hasintro}}
        <div class="playercards-intro">{{{intro}}}</div>
    {{/hasintro}}

    <div class="alert alert-info playercards-placeholder">
        {{#str}} boardcomingsoon, mod_playercards {{/str}}
    </div>

    <button type="button" class="btn btn-secondary" id="playercards-howtoplay-btn">
        {{#str}} howtoplay, mod_playercards {{/str}}
    </button>
</div>
